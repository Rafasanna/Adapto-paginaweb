# Copiar este archivo como .env.local para desarrollo y cargar los valores reales ahí.
# NUNCA poner valores reales en este archivo: se sube a GitHub.
# Las variables sin NEXT_PUBLIC_ son privadas: solo las lee el servidor.

# URL pública del sitio (metadata, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon (Postgres). Esquema en docs/neon-schema.sql
# Sin esta variable el sitio muestra productos de EJEMPLO (modo vista previa).
DATABASE_URL=

# Cloudinary (imágenes de vista previa de los productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firma de las sesiones del admin (mínimo 32 caracteres). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
