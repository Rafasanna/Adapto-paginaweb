# Copiar este archivo como .env.local para desarrollo.
# Las variables sin NEXT_PUBLIC_ son privadas: solo las lee el servidor.

# URL pública del sitio (metadata, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Neon (Postgres). Esquema en docs/neon-schema.sql
# Sin esta variable el sitio muestra productos de EJEMPLO (modo vista previa).
DATABASE_URL=
